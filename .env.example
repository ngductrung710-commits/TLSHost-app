# Runtime connection. A NON-OWNER role, so row-level security actually applies
# — see prisma/setup-role.sql for why that matters in development too.
DATABASE_URL="postgresql://tlshost_app:PASSWORD@localhost:5432/tlshost?schema=public"

# Migrations only. Needs DDL rights and CREATE EXTENSION, so it is the owner.
# Never used by the running application.
MIGRATE_DATABASE_URL="postgresql://postgres:PASSWORD@localhost:5432/tlshost?schema=public"

# Throwaway database used to check migrations against the schema. Rebuilt on
# every run — never point this at data you want.
SHADOW_DATABASE_URL="postgresql://postgres:PASSWORD@localhost:5432/tlshost_shadow?schema=public"

# Optional. Without it the assistant page explains itself and stays disabled;
# everything else in the app works. Get one at console.anthropic.com.
ANTHROPIC_API_KEY=""

# Web push. Generate a fresh pair with:
#   node -e "console.log(JSON.stringify(require('web-push').generateVAPIDKeys()))"
#
# The public key is served to browsers and is not secret. The private key is:
# anyone holding it can send notifications that appear to come from this app.
# The subject must be a mailto: or https: URL a push service can complain to.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:ban@tlshost.vn"

# Encrypts payment credentials at rest. At least 32 characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
#
# Rotating this makes every stored payment secret unreadable — hosts have to
# reconnect. Back it up wherever the database is backed up.
SECRET_KEY=""

# Where hosts transfer money for their own plan.
#
# This is TLSHost's account, not a host's — the Stripe/PayPal credentials a
# host connects to collect from guests live in the database, encrypted, and
# have nothing to do with these.
#
# All four or none: a VietQR built from three of them scans into a transfer
# nobody receives. Leave them empty and the buy button explains that paying
# is not set up yet rather than showing a QR that goes nowhere.
#
# The BIN is Napas' six-digit bank id, not the SWIFT code — 970436 is
# Vietcombank, 970422 is MB, 970418 is BIDV.
TLSHOST_BANK_BIN=""
TLSHOST_BANK_ACCOUNT=""
TLSHOST_BANK_ACCOUNT_NAME=""
TLSHOST_BANK_NAME=""
