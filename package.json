{
  "name": "tlshost-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "check:ical": "esbuild src/lib/ical.ts --bundle --format=esm --platform=node --outfile=.tmp/ical.mjs --alias:@=./src && node scripts/check-ical.mjs",
    "check:sync": "esbuild src/lib/sync.ts --bundle --format=esm --platform=node --packages=external --alias:@=./src --alias:server-only=./scripts/server-only-stub.js --outfile=.tmp/sync.mjs && node --env-file=.env scripts/check-sync.mjs",
    "build:worker": "esbuild src/lib/sync.ts --bundle --format=esm --platform=node --packages=external --alias:@=./src --alias:server-only=./scripts/server-only-stub.js --outfile=.tmp/sync.mjs",
    "sync": "npm run build:worker && node --env-file=.env scripts/sync-worker.mjs",
    "check:proposals": "esbuild src/lib/applyProposal.ts --bundle --format=esm --platform=node --packages=external --alias:@=./src --alias:server-only=./scripts/server-only-stub.js --outfile=.tmp/applyProposal.mjs && node --env-file=.env scripts/check-proposals.mjs",
    "check": "npm run check:ical && npm run check:sync && npm run check:proposals && npm run check:themes && npm run check:appearance && npm run check:plans && npm run check:payments && npm run check:i18n && npm run check:sales",
    "check:themes": "esbuild src/lib/themes.ts --bundle --format=esm --platform=node --outfile=.tmp/themes.mjs --alias:@=./src && node scripts/check-themes.mjs",
    "check:appearance": "node scripts/check-appearance.mjs",
    "check:plans": "esbuild src/lib/plans.ts --bundle --format=esm --platform=node --outfile=.tmp/plans.mjs --alias:@=./src && node scripts/check-plans.mjs",
    "check:payments": "esbuild scripts/payments-entry.ts --bundle --format=esm --platform=node --packages=external --alias:@=./src --alias:server-only=./scripts/server-only-stub.js --outfile=.tmp/payments.mjs && node scripts/check-payments.mjs",
    "check:i18n": "esbuild src/i18n/en.ts --bundle --format=esm --platform=node --outfile=.tmp/en.mjs && node scripts/check-i18n.mjs",
    "check:sales": "esbuild src/lib/sales.ts --bundle --format=esm --platform=node --packages=external --alias:@=./src --alias:server-only=./scripts/server-only-stub.js --outfile=.tmp/sales.mjs && node --env-file=.env scripts/check-sales.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.122.0",
    "@node-rs/argon2": "^2.1.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "next": "16.3.3",
    "pg": "^8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "web-push": "^3.6.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.3",
    "prisma": "^7.10.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
