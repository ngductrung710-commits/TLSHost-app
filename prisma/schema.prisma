// TLSHost PMS — slice 1: accounts, properties, rooms, calendar.
//
// Only what the calendar needs to be correct. Channels, housekeeping, the AI
// assistant and payments are named in the spec but have no tables here yet;
// they all read from Booking and Block, so those two have to be right first.
//
// Two conventions run through the whole file and are not negotiable later:
//
//   1. A stay is stored as two DATE columns, never a timestamp. A night is a
//      calendar concept in the property's timezone, not an instant. Storing an
//      instant buys a family of off-by-one-day bugs that only surface when a
//      guest complains.
//
//   2. Ranges are half-open: [checkIn, checkOut). A guest leaving on the 15th
//      frees the night of the 15th. Nights = checkOut - checkIn with no
//      adjustment, and it matches how iCal defines DTEND for all-day events,
//      so the sync layer added later needs no conversion.
//
// The overlap constraints and row-level security that enforce all of this live
// in migrations/, not here: Prisma's schema language cannot express either.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

/* -------------------------------------------------------------------------- */
/* Tenancy                                                                     */
/* -------------------------------------------------------------------------- */

/// One host business. Every row that carries data belongs to exactly one, and
/// a missing orgId filter is the worst bug this product can have — so it is
/// guarded twice: a Prisma client extension, and Postgres row-level security.
model Organization {
  id       String @id @default(cuid())
  name     String
  /// IANA zone. Decides what "today" means on the board.
  timezone String @default("Asia/Ho_Chi_Minh")
  currency String @default("VND")
  /// Workspace language. "vi" or "en"; the guest booking page follows it too.
  locale   String @default("vi")

  /* -- how the guest booking page looks ------------------------------- */

  /// One of four presets. Not free-form CSS: a host picking a look should not
  /// be able to produce an unreadable page, and four choices that were each
  /// checked for contrast are worth more than infinite ones that were not.
  bookingTheme BookingTheme @default(CLASSIC)

  /// Hex, or null for the preset's own accent. Contrast against the preset's
  /// background is checked on save — a brand colour nobody can read is worse
  /// than the default.
  brandColor String?

  /// Filename under the uploads directory, never a path. Set only by the
  /// upload action, which decides the name itself.
  logoFile   String?

  /* -- what they are paying for --------------------------------------- */

  plan Plan @default(FREE)

  /// Null on FREE, and on a plan that never expires. A date in the past means
  /// the subscription lapsed: limits fall back to FREE but nothing is deleted,
  /// because a host who forgets to pay for a month should not lose a season of
  /// bookings.
  planUntil DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships Membership[]
  properties  Property[]
  rooms       Room[]
  bookings    Booking[]
  blocks      Block[]
  channels    Channel[]
  proposals   AiProposal[]
  pushSubs    PushSubscription[]
  paymentAccounts PaymentAccount[]
  payments        Payment[]

  @@map("organization")
}

model User {
  id           String  @id @default(cuid())
  email        String  @unique
  /// Argon2id. Null for accounts that only ever signed in through a provider.
  passwordHash String?
  name         String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships Membership[]
  sessions    Session[]
  pushSubs    PushSubscription[]

  @@map("user")
}

enum Role {
  OWNER
  COLLABORATOR
  HOUSEKEEPER
}

/// A user's place in one organization. A user may belong to several.
model Membership {
  id     String @id @default(cuid())
  orgId  String
  userId String
  role   Role   @default(OWNER)

  /// Only meaningful for COLLABORATOR. Owners always can; housekeepers never
  /// touch bookings at all.
  canEditOthersBookings Boolean @default(false)

  invitedAt DateTime  @default(now())
  /// Null until they set a password and accept. An unaccepted membership is
  /// invisible to getActiveMember, so an invited person has no access at all
  /// until they act on the invitation.
  joinedAt  DateTime?

  /// SHA-256 of the invite token, never the token — same reasoning as Session.
  /// Cleared on acceptance so a link cannot be replayed.
  inviteTokenHash String?   @unique
  inviteExpiresAt DateTime?

  org             Organization      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  scopes          MembershipScope[]
  createdBookings Booking[]         @relation("BookingCreator")
  cleanedRooms    Room[]            @relation("RoomCleaner")

  @@unique([orgId, userId])
  @@index([userId])
  @@map("membership")
}

/// Which properties a scoped member may see. No rows means every property in
/// the org — the common case for an owner, and the reason this is a separate
/// table rather than a column.
model MembershipScope {
  id           String @id @default(cuid())
  membershipId String
  propertyId   String

  membership Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  property   Property   @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([membershipId, propertyId])
  @@map("membership_scope")
}

/// Server-side sessions, deliberately not JWTs.
///
/// Revoking access has to take effect immediately: when an owner removes a
/// collaborator, that person must lose the calendar on their next request, not
/// whenever a token happens to expire. A row that can be deleted does that; a
/// signed token cannot without a revocation list, which is this table with
/// extra steps.
///
/// Auth.js was the first choice and was dropped after reading @auth/core: its
/// credentials path always issues a JWT cookie and never writes to the adapter
/// session table, whatever the configured strategy says. The needed piece is
/// small enough to own — see src/lib/session.ts.
model Session {
  id String @id @default(cuid())

  /// SHA-256 of the token, never the token. A leaked database backup should
  /// not hand over live sessions, and nothing here needs the original value.
  tokenHash String   @unique
  userId    String
  expiresAt DateTime

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

/* -------------------------------------------------------------------------- */
/* Inventory                                                                   */
/* -------------------------------------------------------------------------- */

/// What kind of place this is. Shown to guests beside the address, because
/// "Homestay" and "Resort" set different expectations before anyone reads a
/// word of the description.
enum PropertyType {
  HOTEL
  BOUTIQUE_HOTEL
  HOMESTAY
  VILLA
  APARTMENT
  GUESTHOUSE
  RESORT
  HOSTEL
}

model Property {
  id    String @id @default(cuid())
  orgId String
  name  String
  /// Nullable: every property created before this column existed has none, and
  /// a host who does not care should not have to pick one.
  type  PropertyType?
  /// The one-line address, composed from the structured parts below when the
  /// wizard writes it. Kept as its own column because every place that shows an
  /// address — the property list, the property page, the guest booking page —
  /// wants exactly one line, and re-composing it in three places would let the
  /// three drift. Still free text: properties created before the structured
  /// columns existed have only this.
  address String?

  /// The address, in the pieces an OTA asks for.
  ///
  /// Booking.com and Airbnb both want street, city, region, postal code and
  /// country as separate fields; a single free-text line cannot be split back
  /// apart reliably enough to send. All nullable — the free-text column above
  /// carries the older rows, and a host mid-setup should not be blocked.
  addressLine1 String?
  /// Building, floor, unit. Optional even in the wizard.
  addressLine2 String?
  city         String?
  region       String?
  postalCode   String?
  /// ISO 3166-1 alpha-2. Defaults to Vietnam, which is where every host is
  /// today; storing it rather than assuming it is what lets that stop being
  /// true without a migration.
  countryCode  String? @default("VN")

  /// ISO 4217. Prices on this property's rooms are in this currency.
  ///
  /// On the property, not the organization: a host with a place in Hoi An and
  /// one in Bangkok prices them differently, and the guest booking page shows
  /// one property at a time.
  currency String @default("VND")

  /// House rules, one per line, shown to guests verbatim.
  houseRules String?

  /// Amenity ids from src/lib/amenities.ts.
  ///
  /// Ids, not labels: the label is Vietnamese today and translated tomorrow,
  /// and a row that stored "Bãi đỗ xe máy" would have to be rewritten for that.
  /// Unknown ids are dropped on read rather than shown raw, so removing an
  /// amenity from the catalogue cannot break a page.
  amenities String[] @default([])

  /// The guest-facing booking page lives at /dat/<slug>.
  ///
  /// Opt-in, like the export feed: a page that exists is a page that can take
  /// a booking, and a host should decide when that starts. Unique across every
  /// organization, because the URL is global.
  ///
  /// Not a secret — it is meant to be shared — so unlike the feed token it is
  /// readable and short.
  publicSlug String? @unique
  /// Turning this off hides the page without giving up the slug.
  published  Boolean @default(false)
  /// Shown under the property name. Plain text; guests see it verbatim.
  intro      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  org    Organization      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  rooms  Room[]
  scopes MembershipScope[]

  @@index([orgId])
  @@map("property")
}

/// The sellable unit. Everything that can be booked or blocked hangs off a
/// room, including whole-villa listings — a villa is a property with one room.
/// Keeping it uniform means the overlap constraint has exactly one shape.
model Room {
  id String @id @default(cuid())

  /// Carried directly, not reached through the property.
  ///
  /// Every other tenant table has one; room was the exception, and the
  /// exception cost a mutually recursive pair of row-level security policies
  /// the moment a second way of identifying a room appeared. A room that
  /// cannot say which organization it belongs to without a join is a room
  /// whose policy has to perform that join, and Postgres refuses when the
  /// other side does the same in reverse.
  orgId      String
  propertyId String
  name       String
  /// Total heads, and the number the calendar and the booking page use.
  ///
  /// Kept as maxAdults + maxChildren at write time rather than derived on read:
  /// every occupancy check in the app already reads this one column, and a
  /// derived value would mean auditing all of them to be sure none compares
  /// against a stale total.
  capacity   Int    @default(2)
  /// The split behind capacity. OTAs price adults and children differently and
  /// ask for the two separately, so the pair is stored even though the app
  /// itself only ever needs the sum.
  maxAdults   Int @default(2)
  maxChildren Int @default(0)
  /// Shown to guests under the room name on the booking page.
  description String?
  /// Amenity ids from src/lib/amenities.ts, same as Property.amenities.
  amenities   String[] @default([])
  /// Minor units, so VND is stored whole. Nullable because a room can exist
  /// before it has been priced.
  basePrice  Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// What the housekeeping board says about this room right now.
  ///
  /// Stored rather than derived, because a person marks it — but "needs
  /// cleaning" is *not* stored: see cleanedAt. That split is what lets a
  /// check-out turn a room dirty with no scheduled job to run.
  cleanState CleanState @default(CLEAN)

  /// When the room was last marked clean, and by whom.
  ///
  /// A room needs cleaning if it was never cleaned, or if a guest has checked
  /// out since. Comparing this timestamp against the last check-out answers
  /// that from data already present — no nightly job to run, nothing to miss
  /// when the job does not run, and a room that self-corrects the moment
  /// anyone looks at it.
  cleanedAt             DateTime?
  cleanedByMembershipId String?

  /// Secret in the public export feed URL. Null until the host asks for one —
  /// a feed that exists is a feed that can leak, so it is opt-in per room.
  icalToken String? @unique

  org      Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  property Property     @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  bookings Booking[]
  blocks   Block[]
  channels Channel[]

  /// SetNull, like Booking's creator: removing someone from the team must not
  /// delete the rooms they cleaned.
  cleanedByMembership Membership? @relation("RoomCleaner", fields: [cleanedByMembershipId], references: [id], onDelete: SetNull)

  @@index([orgId])
  @@index([propertyId])
  @@map("room")
}

/* -------------------------------------------------------------------------- */
/* Channels                                                                    */
/* -------------------------------------------------------------------------- */

/// One OTA's iCal feed for one room.
///
/// Per room rather than per property: OTAs publish availability per listing,
/// and a listing is a room. A villa rented whole is one room, so it gets one
/// channel per OTA and nothing about this is special-cased.
model Channel {
  id     String        @id @default(cuid())
  orgId  String
  roomId String
  kind   BookingSource

  /// The OTA's iCal URL. These carry an unguessable token and are effectively
  /// credentials, which is why the channel list never shows one in full.
  importUrl String
  label     String?

  active Boolean @default(true)

  lastSyncAt   DateTime?
  lastSyncOk   Boolean?
  /// Set when a sync refused to apply deletions. Stays until a later sync
  /// succeeds cleanly, so a host is not told once and left to forget.
  heldDeletions Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  org      Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  room     Room         @relation(fields: [roomId], references: [id], onDelete: Cascade)
  blocks   Block[]
  syncRuns SyncRun[]

  @@unique([roomId, kind])
  @@index([orgId])
  @@map("channel")
}

enum SyncStatus {
  RUNNING
  OK
  FAILED
  /// Finished, but deletions were withheld — see the sync guards.
  HELD
}

/// One attempt at pulling a channel's feed. Kept as a record because "the
/// calendar looks wrong" is answered by knowing what sync did and when.
model SyncRun {
  id        String     @id @default(cuid())
  orgId     String
  channelId String
  status    SyncStatus @default(RUNNING)

  startedAt  DateTime  @default(now())
  finishedAt DateTime?

  eventsSeen    Int @default(0)
  eventsApplied Int @default(0)
  eventsRemoved Int @default(0)
  heldDeletions Int @default(0)

  error String?

  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@index([channelId, startedAt])
  @@index([orgId])
  @@map("sync_run")
}

/* -------------------------------------------------------------------------- */
/* Calendar                                                                    */
/* -------------------------------------------------------------------------- */

/// One browser that has agreed to receive push notifications.
///
/// Per subscription, not per user: someone signs in on a phone and a laptop
/// and wants the phone to buzz. The endpoint is issued by the browser's own
/// push service and is the address messages are sent to; the two keys are what
/// encrypt them, so nothing in transit — including the push service — can read
/// what a notification says.
model PushSubscription {
  id     String @id @default(cuid())
  orgId  String
  userId String

  /// Unique because the browser reissues the same endpoint for the same
  /// device: re-subscribing should update a row, not add one.
  endpoint String @unique
  p256dh   String
  auth     String

  /// For telling one device from another in the settings list.
  userAgent String?

  createdAt DateTime  @default(now())
  /// Cleared on every successful send. A subscription the push service has
  /// rejected is deleted rather than retried forever.
  lastSentAt DateTime?

  org  Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@index([userId])
  @@map("push_subscription")
}

/// Matches the three plans on the marketing site.
///
/// Stored as an enum rather than a set of feature booleans: a plan is a thing
/// a host bought, and the features it unlocks are a fact about the plan, not
/// about the organization. Rows of booleans drift out of step with the pricing
/// page the moment either changes.
enum PaymentProvider {
  STRIPE
  PAYPAL
}

/// A host's own payment account.
///
/// Their credentials, their money. TLSHost never holds funds and never takes a
/// cut: a guest pays into the host's Stripe or PayPal account directly, and
/// this app only ever asks that account to create a checkout and later asks
/// whether it was paid. That is the whole reason the marketing site can say
/// 0% commission without an asterisk.
///
/// The secret is encrypted at rest with a key from the environment. A database
/// backup that leaks must not hand over the ability to move a host's money.
model PaymentAccount {
  id       String          @id @default(cuid())
  orgId    String
  provider PaymentProvider

  /// Stripe's publishable key, or PayPal's client id. Public by design.
  publicId String

  /// AES-256-GCM, base64. Never returned to a page — only decrypted inside the
  /// server action that is about to call the provider.
  secretEnc String

  /// A sandbox account is for a host trying it out. Kept distinct so a real
  /// guest cannot be sent to a test checkout by accident.
  live Boolean @default(false)

  /// Set once the credentials have been used successfully at least once, so
  /// the settings page can say "connected" rather than "we stored something".
  verifiedAt DateTime?
  lastError  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, provider])
  @@map("payment_account")
}

enum PaymentStatus {
  /// A checkout was created and the guest was sent to it.
  PENDING
  PAID
  /// The provider said it failed, or the guest came back without paying.
  FAILED
  REFUNDED
}

/// One attempt to pay for one booking.
///
/// A row per attempt rather than a column on the booking: a guest who
/// abandons a checkout and tries again produces two, and a host asking "did
/// they pay" deserves to see both rather than one field that lost the first.
model Payment {
  id        String          @id @default(cuid())
  orgId     String
  bookingId String
  provider  PaymentProvider

  /// The provider's own id for this checkout — a Stripe session or a PayPal
  /// order. Unique, so a webhook or a return-url hit can only ever settle the
  /// row it belongs to.
  externalId String @unique

  amount   Int
  currency String        @default("VND")
  status   PaymentStatus @default(PENDING)

  createdAt DateTime  @default(now())
  paidAt    DateTime?

  org     Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  booking Booking      @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@index([bookingId])
  @@map("payment")
}

enum Plan {
  /// "Khởi đầu" — one property, direct bookings, 0% commission.
  FREE
  /// "Kênh bán" — unlimited properties and two-way iCal sync.
  CHANNELS
  /// "Chuyên nghiệp" — everything, plus the assistant and scoped team access.
  PRO
}

enum BookingTheme {
  CLASSIC
  MINIMAL
  WARM
  BOLD
}

enum ProposalKind {
  CREATE_BOOKING
  BLOCK_NIGHTS
  CANCEL_BOOKING
  MOVE_BOOKING
  SET_PRICE
  /// The assistant understood the request but there is nothing it can propose.
  NONE
}

enum ProposalStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED
}

/// Something the assistant drafted, waiting for a person.
///
/// The assistant never writes to the calendar. It reads a snapshot and returns
/// one of these; a host approves it and the *application* code applies it
/// through the same guarded paths a host's own click goes through. That is the
/// whole safety model, and it is why this is a table rather than a tool call:
/// a proposal that sits in a row can be shown, compared, and refused, and one
/// that was never approved cannot have happened.
model AiProposal {
  id    String @id @default(cuid())
  orgId String

  /// What the host typed, kept verbatim so a wrong answer can be traced to the
  /// question that produced it.
  prompt  String
  /// One sentence for the list.
  summary String
  kind    ProposalKind

  /// The change itself, validated against a Zod schema on the way in and again
  /// on the way out. JSON rather than columns because each kind has a
  /// different shape and five nullable column sets would be worse.
  payload Json

  status    ProposalStatus @default(PENDING)
  /// Proposals go stale: the nights they describe get taken. A short life means
  /// an approval is always against a recent reading of the calendar.
  expiresAt DateTime

  createdByMembershipId String?
  approvedByUserId      String?
  approvedAt            DateTime?

  /// Filled when applying failed, so the host sees why rather than nothing.
  error String?

  createdAt DateTime @default(now())

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId, createdAt])
  @@map("ai_proposal")
}

enum CleanState {
  CLEAN
  DIRTY
  INSPECTED
  /// Held out of service. Unlike DIRTY this does not clear when someone
  /// cleans — a manager has to take it back.
  MAINTENANCE
}

enum BookingSource {
  DIRECT
  AIRBNB
  BOOKING_COM
  AGODA
  TRAVELOKA
  OTHER
}

enum BookingStatus {
  CONFIRMED
  CANCELLED
}

/// A stay. checkIn is inclusive, checkOut exclusive — see the file header.
///
/// The overlap constraint added in the migration excludes CANCELLED rows, so a
/// cancelled booking keeps its dates as a record without holding the nights.
model Booking {
  id     String @id @default(cuid())
  orgId  String
  roomId String

  guestName  String
  guestEmail String?
  guestPhone String?

  /// @db.Date, both of them. A timestamp here would be a bug.
  checkIn  DateTime @db.Date
  checkOut DateTime @db.Date

  guests    Int           @default(2)
  /// Minor units. Total for the whole stay, not per night.
  totalCents Int?
  source    BookingSource @default(DIRECT)
  status    BookingStatus @default(CONFIRMED)
  notes     String?

  /// Who entered it. Null for bookings that arrived from a channel feed rather
  /// than a person. This is the column the "who created this" trail reads.
  createdByMembershipId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  room      Room         @relation(fields: [roomId], references: [id], onDelete: Cascade)
  createdBy Membership?  @relation("BookingCreator", fields: [createdByMembershipId], references: [id], onDelete: SetNull)
  payments  Payment[]

  @@index([orgId])
  @@index([roomId, checkIn])
  @@map("booking")
}

enum BlockReason {
  MAINTENANCE
  OWNER_STAY
  CHANNEL_SYNC
  OTHER
}

/// Nights held without a guest: maintenance, an owner staying, or a night an
/// OTA has sold that was imported as a block rather than a full booking.
///
/// Separate from Booking rather than a Booking subtype, because a block has no
/// guest, no money and no channel, and folding it in would make half of
/// Booking's columns nullable for the sake of one flag.
model Block {
  id     String @id @default(cuid())
  orgId  String
  roomId String

  dateFrom DateTime    @db.Date
  dateTo   DateTime    @db.Date
  reason   BlockReason @default(MAINTENANCE)
  note     String?

  /// Set on blocks that came from a feed. The pair identifies the row on the
  /// next sync, so an unchanged event updates in place instead of piling up a
  /// duplicate every hour.
  channelId   String?
  externalUid String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  org     Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  room    Room         @relation(fields: [roomId], references: [id], onDelete: Cascade)
  channel Channel?     @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@unique([channelId, externalUid])
  @@index([orgId])
  @@index([roomId, dateFrom])
  @@map("block")
}
